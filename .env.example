# Anthropic API key — get one at console.anthropic.com
# Note: this is billed separately from a Claude.ai subscription
ANTHROPIC_API_KEY=sk-ant-...

# Your full name — used in generated filenames and cover letter signatures.
# e.g. "Jane Smith" → jane-smith-resume-acme-engineer.pdf, "Jane Smith's AI Assistant"
# Kept out of version control so the repo stays generic.
CANDIDATE_NAME=Your Full Name

# ATS composite score threshold for PASS/FAIL (0–100, default 70)
PASS_THRESHOLD=70

# DuckDuckGo results fetched per query (default 10)
SEARCH_RESULTS_PER_QUERY=10
